    else ESPFolder.Parent = game:GetService("CoreGui") end
end)
if not ESPFolder.Parent then ESPFolder.Parent = workspace end

local function CleanupESP(name)
    local c = ESPFolder:FindFirstChild(name)
    if c then c:Destroy() end
end

local function UpdateESP()
    if not Config.RoleESP and not Config.CoinESP then
        ESPFolder:ClearAllChildren()
        return
    end

    -- Role ESP
    if Config.RoleESP then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local char = player.Character
                local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
                local hum  = char:FindFirstChildOfClass("Humanoid")
                if root and hum and hum.Health > 0 then
                    local role = getPlayerRole(player)
                    local roleColor = Color3.fromRGB(0, 255, 120)
                    if role == "Murderer" then roleColor = Color3.fromRGB(255, 50, 50)
                    elseif role == "Sheriff" then roleColor = Color3.fromRGB(50, 150, 255) end

                    local cName = "Role_" .. player.Name
                    local container = ESPFolder:FindFirstChild(cName)
                    if not container then
                        container = Instance.new("Folder"); container.Name = cName; container.Parent = ESPFolder
                    end

                    local hl = container:FindFirstChildOfClass("Highlight")
                    if not hl then
                        hl = Instance.new("Highlight"); hl.Parent = container
                    end
                    hl.Adornee = char; hl.FillColor = roleColor; hl.FillTransparency = 0.5
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255); hl.OutlineTransparency = 0; hl.Enabled = true
                else
                    CleanupESP("Role_" .. player.Name)
                end
            else
                CleanupESP("Role_" .. player.Name)
            end
        end
    else
        for _, child in ipairs(ESPFolder:GetChildren()) do
            if child.Name:find("Role_") then child:Destroy() end
        end
    end

    -- Coin ESP
    if Config.CoinESP then
        local coins = getAllCoinsOnMap()
        for i, coin in ipairs(coins) do
            if coin and coin.Parent then
                local cName = "Coin_" .. tostring(i)
                local container = ESPFolder:FindFirstChild(cName)
                if not container then
                    container = Instance.new("Folder"); container.Name = cName; container.Parent = ESPFolder
                end

                local hl = container:FindFirstChildOfClass("Highlight")
                if not hl then
                    hl = Instance.new("Highlight"); hl.Parent = container
                end
                hl.Adornee = coin; hl.FillColor = Color3.fromRGB(255, 215, 0); hl.FillTransparency = 0.3
                hl.OutlineColor = Color3.fromRGB(255, 255, 255); hl.OutlineTransparency = 0; hl.Enabled = true
            end
        end
    else
        for _, child in ipairs(ESPFolder:GetChildren()) do
            if child.Name:find("Coin_") then child:Destroy() end
        end
    end
end

