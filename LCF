                SLb.Text=lbl; SLb.TextColor3=Theme.TextTitle; SLb.Font=Enum.Font.Gotham; SLb.TextSize=12; SLb.TextXAlignment=Enum.TextXAlignment.Left
                local VLb=Instance.new("TextLabel",SF); VLb.Size=UDim2.new(0,36,0,14); VLb.Position=UDim2.new(1,-36,0,0)
                VLb.BackgroundTransparency=1; VLb.Text=tostring(dv); VLb.TextColor3=Theme.TextTitle; VLb.Font=Enum.Font.Gotham; VLb.TextSize=12; VLb.TextXAlignment=Enum.TextXAlignment.Right
                local Tr=Instance.new("TextButton",SF); Tr.Size=UDim2.new(1,0,0,6); Tr.Position=UDim2.new(0,0,0,20)
                Tr.BackgroundColor3=Theme.TopbarBg; Tr.BorderSizePixel=0; Tr.Text=""; Tr.AutoButtonColor=false
                Instance.new("UICorner",Tr).CornerRadius=UDim.new(1,0)
                local Fi=Instance.new("Frame",Tr); local ip=math.clamp((dv-mn)/(mx-mn),0,1)
                Fi.Size=UDim2.new(ip,0,1,0); Fi.BackgroundColor3=Theme.Accent; Fi.BorderSizePixel=0
                Instance.new("UICorner",Fi).CornerRadius=UDim.new(1,0)
                local sl=false
                Tr.MouseButton1Down:Connect(function() sl=true end)
                UserInputService.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then sl=false end end)
                UserInputService.InputChanged:Connect(function(i)
                    if sl and i.UserInputType==Enum.UserInputType.MouseMovement then
                        local p=math.clamp((i.Position.X-Tr.AbsolutePosition.X)/Tr.AbsoluteSize.X,0,1)
                        Fi.Size=UDim2.new(p,0,1,0); local v=math.floor(mn+(mx-mn)*p); VLb.Text=tostring(v); cb(v)
                    end
                end)
                pcall(cb,dv)
            end
            function SO:AddButton(lbl,cb)
                local Btn=Instance.new("TextButton",TC); Btn.Size=UDim2.new(1,-8,0,28); Btn.Position=UDim2.new(0,4,0,0)
                Btn.BackgroundColor3=Theme.TopbarBg; Btn.BorderSizePixel=0; Btn.Text=lbl; Btn.TextColor3=Theme.TextTitle
                Btn.Font=Enum.Font.Gotham; Btn.TextSize=13; Btn.AutoButtonColor=false
                Instance.new("UICorner",Btn).CornerRadius=UDim.new(0,4)
                Btn.MouseButton1Click:Connect(cb)
                Btn.MouseEnter:Connect(function() Btn.BackgroundColor3=Color3.fromRGB(40,40,55) end)
                Btn.MouseLeave:Connect(function() Btn.BackgroundColor3=Theme.TopbarBg end)
            end
            return SO
        end
        return TabObj
    end
    return Win
end

