            Window.CurrentTab = tabName
            TabBtn.BackgroundColor3 = Theme.TabActive
            TabContent.Visible = true
        end

        table.insert(Window.Tabs, {Btn = TabBtn, Content = TabContent})

        local TabObj = {}
        function TabObj:AddSubTab(subName, icon)
            -- Ignore SubTabs, just return self so Sections go into the Main Tab
            return TabObj
        end

        function TabObj:AddSection(secName, side)
            -- Just a spacer with title for Owl Hub style
            local SecFrame = Instance.new("Frame")
            SecFrame.Size = UDim2.new(1, 0, 0, 20)
            SecFrame.BackgroundTransparency = 1
            SecFrame.Parent = TabContent

            local SecTitle = Instance.new("TextLabel")
            SecTitle.Size = UDim2.new(1, 0, 1, 0)
            SecTitle.BackgroundTransparency = 1
            SecTitle.Text = secName
            SecTitle.TextColor3 = Theme.TextSub
            SecTitle.Font = Enum.Font.Gotham
            SecTitle.TextSize = 11
            SecTitle.TextXAlignment = Enum.TextXAlignment.Left
            SecTitle.Parent = SecFrame

            local SectionObj = {}
            
            function SectionObj:AddToggle(title, subtitle, defaultValue, callback)
                local TglFrame = Instance.new("TextButton")
                TglFrame.Size = UDim2.new(1, 0, 0, 30)
                TglFrame.BackgroundTransparency = 1
                TglFrame.Text = ""
                TglFrame.Parent = TabContent

                local Box = Instance.new("Frame")
                Box.Size = UDim2.new(0, 16, 0, 16)
                Box.Position = UDim2.new(0, 0, 0.5, -8)
                Box.BackgroundColor3 = defaultValue and Theme.Accent or Theme.TopbarBg
                Box.BorderSizePixel = 0
                Box.Parent = TglFrame

                local TglText = Instance.new("TextLabel")
                TglText.Size = UDim2.new(1, -25, 1, 0)
                TglText.Position = UDim2.new(0, 25, 0, 0)
                TglText.BackgroundTransparency = 1
                TglText.Text = title
                TglText.TextColor3 = Theme.TextTitle
                TglText.Font = Enum.Font.Gotham
                TglText.TextSize = 13
                TglText.TextXAlignment = Enum.TextXAlignment.Left
                TglText.Parent = TglFrame

                local toggled = defaultValue
                TglFrame.MouseButton1Click:Connect(function()
                    toggled = not toggled
                    Box.BackgroundColor3 = toggled and Theme.Accent or Theme.TopbarBg
                    callback(toggled)
                end)
                if defaultValue then callback(defaultValue) end
            end

            function SectionObj:AddSlider(sliderText, minVal, maxVal, defaultVal, callback)
                local SldFrame = Instance.new("Frame")
                SldFrame.Size = UDim2.new(1, 0, 0, 35)
                SldFrame.BackgroundTransparency = 1
                SldFrame.Parent = TabContent

                local Title = Instance.new("TextLabel")
                Title.Size = UDim2.new(1, -40, 0, 15)
                Title.Position = UDim2.new(0, 0, 0, 0)
                Title.BackgroundTransparency = 1
                Title.Text = sliderText
                Title.TextColor3 = Theme.TextTitle
                Title.Font = Enum.Font.Gotham
                Title.TextSize = 13
                Title.TextXAlignment = Enum.TextXAlignment.Left
                Title.Parent = SldFrame

                local ValText = Instance.new("TextLabel")
                ValText.Size = UDim2.new(0, 40, 0, 15)
                ValText.Position = UDim2.new(1, -40, 0, 0)
                ValText.BackgroundTransparency = 1
                ValText.Text = tostring(defaultVal)
                ValText.TextColor3 = Theme.TextTitle
                ValText.Font = Enum.Font.Gotham
                ValText.TextSize = 13
                ValText.TextXAlignment = Enum.TextXAlignment.Right
                ValText.Parent = SldFrame

                local Track = Instance.new("TextButton")
                Track.Size = UDim2.new(1, 0, 0, 4)
                Track.Position = UDim2.new(0, 0, 0, 20)
                Track.BackgroundColor3 = Theme.TopbarBg
                Track.BorderSizePixel = 0
                Track.Text = ""
                Track.AutoButtonColor = false
                Track.Parent = SldFrame

                local Fill = Instance.new("Frame")
                local pct = math.clamp((defaultVal - minVal) / (maxVal - minVal), 0, 1)
                Fill.Size = UDim2.new(pct, 0, 1, 0)
                Fill.BackgroundColor3 = Theme.Accent
                Fill.BorderSizePixel = 0
                Fill.Parent = Track

                local dragging = false
                Track.MouseButton1Down:Connect(function() dragging = true end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                        local size = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                        Fill.Size = UDim2.new(size, 0, 1, 0)
                        local val = math.floor(minVal + (maxVal - minVal) * size)
                        ValText.Text = tostring(val)
                        callback(val)
                    end
                end)
                callback(defaultVal)
            end

            function SectionObj:AddButton(title, callback)
                local BtnFrame = Instance.new("TextButton")
                BtnFrame.Size = UDim2.new(1, -10, 0, 30)
                BtnFrame.Position = UDim2.new(0, 5, 0, 0)
                BtnFrame.BackgroundColor3 = Theme.TopbarBg
                BtnFrame.BorderSizePixel = 0
                BtnFrame.Text = title
                BtnFrame.TextColor3 = Theme.TextTitle
                BtnFrame.Font = Enum.Font.Gotham
                BtnFrame.TextSize = 13
                BtnFrame.Parent = TabContent
                
                BtnFrame.MouseButton1Click:Connect(callback)
            end

            return SectionObj
        end
        return TabObj
    end
    return Window
end


