local Tracers = {}

local function CleanupPlayerESP(player)
    local c = ESPFolder:FindFirstChild("ESP_" .. player.Name)
    if c then c:Destroy() end
    if Tracers[player] then
        pcall(function() Tracers[player]:Remove() end)
        Tracers[player] = nil
    end
end

local function UpdatePlayerESP(player)
    if player == LocalPlayer then return end
    local char = player.Character
    if not char then CleanupPlayerESP(player) return end
    local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
    local hum  = char:FindFirstChildOfClass("Humanoid")
    if not Config.ESP and not Config.Tracers then CleanupPlayerESP(player) return end
    if not root or not hum or hum.Health <= 0 then CleanupPlayerESP(player) return end
    local isTeam = false
    if Config.TeamCheck and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then isTeam = true end
    if isTeam then CleanupPlayerESP(player) return end

    if Config.ESP then
        local cn = "ESP_" .. player.Name
        local container = ESPFolder:FindFirstChild(cn)
        if not container then container = Instance.new("Folder"); container.Name = cn; container.Parent = ESPFolder end

        local hl = container:FindFirstChildOfClass("Highlight")
        if Config.Chams then
            if not hl then hl = Instance.new("Highlight"); hl.Parent = container end
            hl.Adornee = char; hl.FillColor = Theme.Accent; hl.FillTransparency = 0.5
            hl.OutlineColor = Color3.fromRGB(255,255,255); hl.OutlineTransparency = 0; hl.Enabled = true
        elseif hl then hl.Enabled = false end

        local bb = container:FindFirstChildOfClass("BillboardGui")
        if not bb then
            bb = Instance.new("BillboardGui"); bb.Name = "BB"; bb.AlwaysOnTop = true
            bb.Size = UDim2.new(4.5,0,6,0); bb.StudsOffset = Vector3.new(0,0,0); bb.Parent = container
            local bf = Instance.new("Frame"); bf.Name="BoxFrame"; bf.Size=UDim2.new(1,0,1,0)
            bf.BackgroundTransparency=1; bf.BorderColor3=Theme.Accent; bf.BorderSizePixel=2; bf.Parent=bb
            local nl = Instance.new("TextLabel"); nl.Name="NameLabel"; nl.Size=UDim2.new(1,0,0,15)
            nl.Position=UDim2.new(0,0,0,-18); nl.BackgroundTransparency=1; nl.TextColor3=Color3.fromRGB(255,255,255)
            nl.Font=Enum.Font.GothamBold; nl.TextSize=11; nl.TextStrokeTransparency=0
            nl.TextXAlignment=Enum.TextXAlignment.Center; nl.Parent=bb
            local hbg = Instance.new("Frame"); hbg.Name="HBg"; hbg.Size=UDim2.new(0,4,1,0)
            hbg.Position=UDim2.new(0,-8,0,0); hbg.BackgroundColor3=Color3.fromRGB(20,20,20)
            hbg.BorderSizePixel=1; hbg.Parent=bb
            local hfl = Instance.new("Frame"); hfl.Name="HFl"; hfl.Size=UDim2.new(1,0,1,0)
            hfl.BackgroundColor3=Color3.fromRGB(0,255,100); hfl.BorderSizePixel=0; hfl.Parent=hbg
        end
        bb.Adornee = root
        local bf2 = bb:FindFirstChild("BoxFrame"); if bf2 then bf2.Visible = Config.BoxESP end
        local nl2 = bb:FindFirstChild("NameLabel")
        if nl2 then nl2.Visible = Config.NameESP
            if Config.NameESP then
                local d = math.floor((root.Position - Camera.CFrame.Position).Magnitude)
                nl2.Text = player.Name.." ["..d.."m]"
            end
        end
        local hbg2 = bb:FindFirstChild("HBg"); if hbg2 then hbg2.Visible = Config.HealthBar
            local hfl2 = hbg2:FindFirstChild("HFl")
            if hfl2 and hum then
                local pct = math.clamp(hum.Health/hum.MaxHealth,0,1)
                hfl2.Size = UDim2.new(1,0,pct,0); hfl2.Position = UDim2.new(0,0,1-pct,0)
                if pct > 0.5 then hfl2.BackgroundColor3 = Color3.fromRGB(math.floor(255*(1-pct)*2),255,0)
                else hfl2.BackgroundColor3 = Color3.fromRGB(255,math.floor(255*pct*2),0) end
            end
        end
    else
        local c2 = ESPFolder:FindFirstChild("ESP_"..player.Name); if c2 then c2:Destroy() end
    end

    if Config.Tracers and Drawing then
        local pos, onSc = Camera:WorldToViewportPoint(root.Position)
        if onSc then
            if not Tracers[player] then
                local ln = Drawing.new("Line"); ln.Thickness=1.5; ln.Color=Theme.Accent
                ln.Transparency=1; Tracers[player]=ln
            end
            local ln = Tracers[player]
            ln.From=Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
            ln.To=Vector2.new(pos.X,pos.Y); ln.Visible=true
        else if Tracers[player] then Tracers[player].Visible=false end end
    else if Tracers[player] then Tracers[player].Visible=false end end
end

-- COMBAT ENGINE
-- Advanced visibility: 3-ray multi-point check (head, HRP, torso)
-- Returns true only if at least 2 of 3 points are unobstructed
local function IsVisible(character)
    if not Config.WallCheck then return true end
    local cam = workspace.CurrentCamera
    if not cam then return false end
    local origin = cam.CFrame.Position

    local checkParts = {
        character:FindFirstChild("Head"),
        character:FindFirstChild("HumanoidRootPart"),
        character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso"),
    }

    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = {LocalPlayer.Character, character}
    rp.IgnoreWater = true

    local hits = 0
    for _, part in ipairs(checkParts) do
        if part then
            local dir = part.Position - origin
            local result = workspace:Raycast(origin, dir, rp)
            if result == nil then
                hits += 1
            end
        end
    end
    return hits >= 2
end

-- Advanced target selection:
-- Scores by screen FOV distance + world distance, requires on-screen + visible + within MaxDist
local function GetTarget()
    local cam = workspace.CurrentCamera
    if not cam then return nil, nil end
    local mp = UserInputService:GetMouseLocation()
    local cp, ct = nil, nil
    local bestScore = math.huge

    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LocalPlayer then
            local isT = Config.TeamCheck and pl.Team and LocalPlayer.Team and pl.Team == LocalPlayer.Team
            if not isT then
                local ch = pl.Character
                if ch then
                    local hu = ch:FindFirstChildOfClass("Humanoid")
                    local hrp = ch:FindFirstChild("HumanoidRootPart")
                    if hu and hrp and hu.Health > 0 then
                        -- World distance gate — ignore players too far away
                        local worldDist = (hrp.Position - cam.CFrame.Position).Magnitude
                        if worldDist <= Config.MaxDist then
                            local head = ch:FindFirstChild("Head") or hrp
                            local sp, onScreen = cam:WorldToViewportPoint(head.Position)
                            if onScreen then
                                local screenDist = (Vector2.new(sp.X, sp.Y) - mp).Magnitude
                                if screenDist <= Config.FOV then
                                    if IsVisible(ch) then
                                        -- Combined score: screen FOV closeness + normalised world distance
                                        local score = screenDist + (worldDist / Config.MaxDist) * 50
                                        if score < bestScore then
                                            bestScore = score
                                            cp = pl
                                            ct = head
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return ct, cp
end

-- Silent Aim Hook
pcall(function()
    if not (getrawmetatable and setreadonly) then return end
    local grm = getrawmetatable(game); if not grm then return end
    local oNC = grm.__namecall; local oIdx = grm.__index
    local cc = checkcaller or function() return false end
    setreadonly(grm, false)
    grm.__namecall = newcclosure(function(self, ...)
        local m = getnamecallmethod and getnamecallmethod() or ""
        if Config.SilentAim and not cc() then
            if m=="FindPartOnWithIgnoreList" or m=="Raycast" or m=="raycast" then
                local t = GetTarget()
                if t then
                    local a = {...}
                    if a[1] and a[1].Origin then
                        local o = a[1].Origin; a[1]=Ray.new(o,(t.Position-o).Unit*1000)
                        return oNC(self,unpack(a))
                    end
                end
            end
        end
        return oNC(self,...)
    end)
    grm.__index = newcclosure(function(self, key)
        if Config.SilentAim and not cc() then
            if self == LocalPlayer:GetMouse() then
                if key=="Hit" or key=="hit" then local t=GetTarget(); if t then return t.CFrame end
                elseif key=="Target" or key=="target" then local t=GetTarget(); if t then return t end end
            end
        end
        return oIdx(self, key)
    end)
    setreadonly(grm, true)
end)

