-- ====================================================================
-- MM2 UTILITIES & ROLE DETECTION
-- ====================================================================
local function GetPlayerRole(player)
    if not player or not player.Character then return "Innocent" end
    
    -- Check Character tools
    if player.Character:FindFirstChild("Knife") then return "Murderer" end
    if player.Character:FindFirstChild("Gun") then return "Sheriff" end

    -- Check Backpack tools
    local bp = player:FindFirstChild("Backpack")
    if bp then
        if bp:FindFirstChild("Knife") then return "Murderer" end
        if bp:FindFirstChild("Gun") then return "Sheriff" end
    end

    return "Innocent"
end

local function GetRoleColor(role)
    if role == "Murderer" then
        return Color3.fromRGB(255, 40, 40)
    elseif role == "Sheriff" then
        return Color3.fromRGB(0, 150, 255)
    else
        return Color3.fromRGB(0, 255, 120)
    end
end

local function GetMurderer()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and GetPlayerRole(player) == "Murderer" then
            return player
        end
    end
    return nil
end

local function GetClosestTarget(maxDist)
    local closest = nil
    local shortest = maxDist or math.huge
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local myPos = LocalPlayer.Character.HumanoidRootPart.Position
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChildOfClass("Humanoid") then
                if player.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
                    local dist = (player.Character.HumanoidRootPart.Position - myPos).Magnitude
                    if dist < shortest then
                        shortest = dist
                        closest = player
                    end
                end
            end
        end
    end
    return closest
end

local function IsValidCoinPart(part)
    if not part or not part:IsA("BasePart") then return false end
    if part.Transparency >= 0.9 then return false end
    if part:FindFirstAncestor("Lobby") or part:FindFirstAncestor("Shop") or part:FindFirstAncestor("PlayerGui") then return false end
    local name = part.Name:lower()
    local pName = part.Parent and part.Parent.Name:lower() or ""
    if name == "maincoin" or name == "coin" or name:find("coin") or name:find("token") or pName == "coincontainer" or pName:find("coin") then
        return true
    end
    return false
end

-- ====================================================================
-- ESP ENGINE (BillboardGui Parented Directly To RootPart)
-- ====================================================================
local function RemovePlayerESP(player)
    if player and player.Character then
        local hrp = player.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local oldGui = hrp:FindFirstChild("Luno_MM2_ESP_Gui")
            if oldGui then oldGui:Destroy() end
        end
        local oldHighlight = player.Character:FindFirstChild("Luno_MM2_Chams")
        if oldHighlight then oldHighlight:Destroy() end
    end
end

local function UpdatePlayerESP(player)
    if not Config.RoleESP or player == LocalPlayer or not player.Character then
        RemovePlayerESP(player)
        return
    end

    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
    local hum = player.Character:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then
        RemovePlayerESP(player)
        return
    end

    local role = GetPlayerRole(player)
    local roleColor = GetRoleColor(role)

    -- BillboardGui
    local bgui = hrp:FindFirstChild("Luno_MM2_ESP_Gui")
    if not bgui then
        bgui = Instance.new("BillboardGui")
        bgui.Name = "Luno_MM2_ESP_Gui"
        bgui.AlwaysOnTop = true
        bgui.Size = UDim2.new(0, 160, 0, 50)
        bgui.StudsOffset = Vector3.new(0, 3, 0)
        bgui.Parent = hrp

        local titleLabel = Instance.new("TextLabel")
        titleLabel.Name = "TitleLabel"
        titleLabel.Size = UDim2.new(1, 0, 0, 20)
        titleLabel.BackgroundTransparency = 1
        titleLabel.Font = Enum.Font.GothamBold
        titleLabel.TextSize = 13
        titleLabel.TextStrokeTransparency = 0.4
        titleLabel.Parent = bgui

        local subLabel = Instance.new("TextLabel")
        subLabel.Name = "SubLabel"
        subLabel.Size = UDim2.new(1, 0, 0, 16)
        subLabel.Position = UDim2.new(0, 0, 0, 20)
        subLabel.BackgroundTransparency = 1
        subLabel.Font = Enum.Font.GothamSemibold
        subLabel.TextSize = 11
        subLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
        subLabel.TextStrokeTransparency = 0.5
        subLabel.Parent = bgui
    end

    local dist = 0
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        dist = math.floor((hrp.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude)
    end

    local titleLabel = bgui:FindFirstChild("TitleLabel")
    local subLabel   = bgui:FindFirstChild("SubLabel")
    if titleLabel and subLabel then
        if Config.NameESP then
            titleLabel.Text = string.format("[%s] %s", role:upper(), player.Name)
            titleLabel.TextColor3 = roleColor
            subLabel.Text = string.format("%d studs", dist)
        else
            titleLabel.Text = ""
            subLabel.Text = ""
        end
    end

    -- Chams Highlight
    local chams = player.Character:FindFirstChild("Luno_MM2_Chams")
    if Config.BoxESP then
        if not chams then
            chams = Instance.new("Highlight")
            chams.Name = "Luno_MM2_Chams"
            chams.Parent = player.Character
        end
        chams.FillColor = roleColor
        chams.OutlineColor = Color3.fromRGB(255, 255, 255)
        chams.FillTransparency = 0.5
        chams.OutlineTransparency = 0
        chams.Enabled = true
    elseif chams then
        chams.Enabled = false
    end
end

