                local TB2=Instance.new("TextButton",TC); TB2.Size=UDim2.new(1,0,0,28); TB2.BackgroundTransparency=1; TB2.Text=""; TB2.AutoButtonColor=false
                local Box=Instance.new("Frame",TB2); Box.Size=UDim2.new(0,14,0,14); Box.Position=UDim2.new(0,4,0.5,-7)
                Box.BackgroundColor3=def and Theme.Accent or Theme.TopbarBg; Box.BorderSizePixel=0
                Instance.new("UICorner",Box).CornerRadius=UDim.new(0,3)
                local TL2=Instance.new("TextLabel",TB2); TL2.Size=UDim2.new(1,-28,1,0); TL2.Position=UDim2.new(0,26,0,0)
                TL2.BackgroundTransparency=1; TL2.Text=lbl; TL2.TextColor3=Theme.TextTitle; TL2.Font=Enum.Font.Gotham; TL2.TextSize=13; TL2.TextXAlignment=Enum.TextXAlignment.Left
                local st=def or false
                TB2.MouseButton1Click:Connect(function() st=not st; Box.BackgroundColor3=st and Theme.Accent or Theme.TopbarBg; cb(st) end)
                if st then pcall(cb,st) end
            end
            function SO:AddSlider(lbl,mn,mx,dv,cb)
