local function UnloadScript()
    Config.ESP=false; Config.Tracers=false
    Config.ZeroGravity=false; Config.Fullbright=false; Config.NoShadows=false; Config.NoFog=false
    workspace.Gravity=196
    if Lighting and OriginalLighting then
        Lighting.Ambient=OriginalLighting.Ambient; Lighting.OutdoorAmbient=OriginalLighting.OutdoorAmbient
        Lighting.Brightness=OriginalLighting.Brightness; Lighting.GlobalShadows=OriginalLighting.GlobalShadows
        Lighting.FogEnd=OriginalLighting.FogEnd
    end
    for _,pl in ipairs(Players:GetPlayers()) do
        CleanupPlayerESP(pl)
    end
    if FOVCircle then pcall(function() FOVCircle:Remove() end) end
    local g=game:GetService("CoreGui"):FindFirstChild("LunoArsenalFlat"); if g then g:Destroy() end
end

