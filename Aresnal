-- ====================================================================
-- MAIN LOOP
-- ====================================================================
RunService.RenderStepped:Connect(function()
    Camera = workspace.CurrentCamera

    if Config.Aimbot then
        local ok=true
        if Config.HoldToAim then ok=UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) end
        if ok then
            local tp=GetTarget()
            if tp and Camera then
                local cCF=Camera.CFrame; local tCF=CFrame.lookAt(cCF.Position,tp.Position)
                local sm=math.clamp(Config.AimbotSmoothness,1,20)
                Camera.CFrame=sm<=1 and tCF or cCF:Lerp(tCF,1/sm)
            end
        end
    end


    if FOVCircle then
        FOVCircle.Position=UserInputService:GetMouseLocation(); FOVCircle.Radius=Config.FOV
        FOVCircle.Visible=Config.ShowFOV and (Config.Aimbot or Config.SilentAim)
    end



    if LocalPlayer.Character then
        local h=LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if h then
            if Config.EnableSpeed then h.WalkSpeed=Config.WalkSpeed end
            if Config.EnableJump  then h.UseJumpPower=true; h.JumpPower=Config.JumpPower end
        end
    end


    workspace.Gravity = Config.Gravity

    if Config.Fullbright then
        Lighting.Ambient=Color3.fromRGB(255,255,255); Lighting.OutdoorAmbient=Color3.fromRGB(255,255,255); Lighting.Brightness=2
    elseif Config.NightMode then
        Lighting.ClockTime=0; Lighting.OutdoorAmbient=Color3.fromRGB(20,20,40); Lighting.Ambient=Color3.fromRGB(15,15,30)
    end

    if Config.NoShadows then Lighting.GlobalShadows=false end
    if Config.NoFog     then Lighting.FogEnd=9e9 end
    if Camera           then Camera.FieldOfView=Config.CameraFOV end

    for _,pl in ipairs(Players:GetPlayers()) do UpdatePlayerESP(pl) end
end)

