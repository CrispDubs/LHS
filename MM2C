-- ====================
-- Main Logic Loop
-- ====================
RunService.RenderStepped:Connect(function()
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("Humanoid") then return end

    -- NoClip
    if Config.NoClip and LocalPlayer.Character then
        for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end
    
    -- Player Mods
    if Config.WalkSpeed > 16 and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character:FindFirstChild("Humanoid") then
        local moveDir = LocalPlayer.Character.Humanoid.MoveDirection
        if moveDir.Magnitude > 0 then
            LocalPlayer.Character.HumanoidRootPart.CFrame = LocalPlayer.Character.HumanoidRootPart.CFrame + (moveDir * (Config.WalkSpeed - 16) * 0.015)
        end
    end
    if LocalPlayer.Character.Humanoid.JumpPower ~= Config.JumpPower then
        LocalPlayer.Character.Humanoid.JumpPower = Config.JumpPower
    end

    -- Hitbox Expander (Applied cleanly without constant reallocation)
    if Config.HitboxExpander then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local root = player.Character:FindFirstChild("HumanoidRootPart") or player.Character:FindFirstChild("UpperTorso") or player.Character:FindFirstChild("Torso")
                if root and root:IsA("BasePart") then
                    root.Size = Vector3.new(Config.HitboxSize, Config.HitboxSize, Config.HitboxSize)
                    root.Transparency = 0.6
                    root.CanCollide = false
                end
            end
        end
    else
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local root = player.Character:FindFirstChild("HumanoidRootPart")
                if root and root.Size.X > 2 then
                    root.Size = Vector3.new(2, 2, 1)
                    root.Transparency = 1
                end
            end
        end
    end

    -- Kill Aura
    if Config.KillAura then
        local knife = LocalPlayer.Character:FindFirstChild("Knife")
        if knife then
            local target = getClosestPlayer(Config.AuraRange)
            if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                local slashRemote = knife:FindFirstChild("Slash")
                if slashRemote then
                    slashRemote:FireServer(target.Character.HumanoidRootPart.Position)
                end
            end
        end
    end

    -- Optimized Role ESP (Reuses single Highlight per character without re-querying descendants)
    if Config.ESP then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local role = getRole(player)
                local color = Color3.fromRGB(0, 255, 100)
                if role == "Murderer" then
                    color = Color3.fromRGB(255, 40, 40)
                elseif role == "Sheriff" then
                    color = Color3.fromRGB(0, 150, 255)
                end

                local esp = player.Character:FindFirstChild("ESP_Luno")
                if not esp then
                    esp = Instance.new("Highlight")
                    esp.Name = "ESP_Luno"
                    esp.FillTransparency = 0.5
                    esp.OutlineTransparency = 0
                    esp.Parent = player.Character
                end
                esp.FillColor = color
                esp.OutlineColor = Color3.fromRGB(255, 255, 255)
                esp.Enabled = true
            end
        end
    end
end)

-- Optimized Gun & Coin ESP Scanners (Runs on background thread instead of every frame to eliminate lag)
task.spawn(function()
    while true do
        task.wait(0.5)
        if Config.GunESP then
            for _, drop in ipairs(workspace:GetDescendants()) do
                if drop.Name == "GunDrop" then
                    if not drop:FindFirstChild("ESP_Luno_Gun") then
                        local esp = Instance.new("Highlight")
                        esp.Name = "ESP_Luno_Gun"
                        esp.FillColor = Color3.fromRGB(255, 215, 0)
                        esp.OutlineColor = Color3.fromRGB(255, 255, 255)
                        esp.FillTransparency = 0.2
                        esp.Parent = drop
                    end
                end
            end
        end

        if Config.CoinESP then
            for _, desc in ipairs(workspace:GetDescendants()) do
                if isValidCoin(desc) then
                    if not desc:FindFirstChild("ESP_Luno_Coin") then
                        local esp = Instance.new("Highlight")
                        esp.Name = "ESP_Luno_Coin"
                        esp.FillColor = Color3.fromRGB(255, 215, 0)
                        esp.OutlineColor = Color3.fromRGB(255, 255, 255)
                        esp.FillTransparency = 0.3
                        esp.Parent = desc
                    end
                end
            end
        end
    end
end)

-- Tracers Logic (Drawing API)
local camera = workspace.CurrentCamera
local Tracers = {}

RunService.RenderStepped:Connect(function()
    if Config.Tracers then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local role = getRole(player)
                if role == "Murderer" or role == "Sheriff" then
                    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                        local rootPart = player.Character.HumanoidRootPart
                        local pos, onScreen = camera:WorldToViewportPoint(rootPart.Position)
                        
                        if onScreen then
                            if not Tracers[player.Name] then
                                Tracers[player.Name] = Drawing.new("Line")
                                Tracers[player.Name].Thickness = 2
                                Tracers[player.Name].Transparency = 1
                            end
                            
                            local tracer = Tracers[player.Name]
                            tracer.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y)
                            tracer.To = Vector2.new(pos.X, pos.Y)
                            tracer.Visible = true
                            
                            if role == "Murderer" then
                                tracer.Color = Color3.fromRGB(255, 0, 0)
                            else
                                tracer.Color = Color3.fromRGB(0, 0, 255)
                            end
                        else
                            if Tracers[player.Name] then
                                Tracers[player.Name].Visible = false
                            end
                        end
                    elseif Tracers[player.Name] then
                        Tracers[player.Name].Visible = false
                    end
                elseif Tracers[player.Name] then
                    Tracers[player.Name]:Remove()
                    Tracers[player.Name] = nil
                end
            end
        end
    else
        for k, v in pairs(Tracers) do
            v:Remove()
            Tracers[k] = nil
        end
    end
end)

Players.PlayerRemoving:Connect(function(player)
    if Tracers[player.Name] then
        Tracers[player.Name]:Remove()
        Tracers[player.Name] = nil
    end
end)

-- Auto Collect Gun Listener
workspace.DescendantAdded:Connect(function(descendant)
    if Config.AutoCollectGun and descendant.Name == "GunDrop" then
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            -- Wait a split second for the gun to fully physics-simulate before TPing to it
            task.wait(0.1)
            if descendant.Parent then
                LocalPlayer.Character.HumanoidRootPart.CFrame = descendant.CFrame
            end
        end
    end
end)

-- Background Tasks (Kill All & Fling)
task.spawn(function()
    while task.wait(0.2) do
        -- Kill All
        if Config.KillAllAsMurderer and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local knife = LocalPlayer.Character:FindFirstChild("Knife")
            if knife then
                for _, player in pairs(Players:GetPlayers()) do
                    if Config.KillAllAsMurderer and player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
                        LocalPlayer.Character.HumanoidRootPart.CFrame = player.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
                        local slashRemote = knife:FindFirstChild("Slash")
                        if slashRemote then
                            slashRemote:FireServer(player.Character.HumanoidRootPart.Position)
                        end
                        task.wait(0.25)
                    end
                end
            end
        end
        
        -- Fling Murderer
        if Config.FlingMurderer and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local murderer = getMurderer()
            if murderer and murderer.Character and murderer.Character:FindFirstChild("HumanoidRootPart") then
                -- Teleport inside them and spin wildly
                LocalPlayer.Character.HumanoidRootPart.CFrame = murderer.Character.HumanoidRootPart.CFrame
                LocalPlayer.Character.HumanoidRootPart.Velocity = Vector3.new(10000, 10000, 10000)
                LocalPlayer.Character.HumanoidRootPart.RotVelocity = Vector3.new(10000, 10000, 10000)
            end
        end
    end
end)
