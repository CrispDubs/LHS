            local SL=Instance.new("TextLabel",Sp); SL.Size=UDim2.new(1,0,1,0); SL.BackgroundTransparency=1
            SL.Text=sn; SL.TextColor3=Theme.TextSub; SL.Font=Enum.Font.GothamSemibold; SL.TextSize=11; SL.TextXAlignment=Enum.TextXAlignment.Left
            local SO={}
