            for _, t in pairs(Window.Tabs) do
                t.Btn.BackgroundColor3 = Theme.TabBg
                t.Content.Visible = false
            end
            TabBtn.BackgroundColor3 = Theme.TabActive
            TabContent.Visible = true
        end)

