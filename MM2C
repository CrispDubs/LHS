renderConn = RunService.RenderStepped:Connect(function()
    if not scriptRunning then return end
    Camera = workspace.CurrentCamera

    -- Player Movement Mods
    if LocalPlayer.Character then
        local h = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if h then
            if Config.EnableSpeed then h.WalkSpeed = Config.WalkSpeed end
            if Config.EnableJump  then h.UseJumpPower = true; h.JumpPower = Config.JumpPower end
        end
    end

    -- Player ESP Update
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LocalPlayer then UpdatePlayerESP(pl) end
    end

    -- Murderer Radar HUD Update
    if Config.MurdererRadar then
        local radarGui = Window.ScreenGui:FindFirstChild("Luno_MM2_Radar")
        if not radarGui then
            radarGui = Instance.new("Frame")
            radarGui.Name = "Luno_MM2_Radar"
            radarGui.Size = UDim2.new(0, 260, 0, 36)
            radarGui.Position = UDim2.new(0.5, -130, 0, 15)
            radarGui.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
            radarGui.BorderSizePixel = 0
            radarGui.Parent = Window.ScreenGui

            Instance.new("UICorner", radarGui).CornerRadius = UDim.new(0, 8)
            local rStroke = Instance.new("UIStroke", radarGui)
            rStroke.Color = Theme.Accent; rStroke.Thickness = 1.5

            local rText = Instance.new("TextLabel", radarGui)
            rText.Name = "RadarText"
            rText.Size = UDim2.new(1, 0, 1, 0)
            rText.BackgroundTransparency = 1
            rText.TextColor3 = Color3.fromRGB(255, 255, 255)
            rText.Font = Enum.Font.GothamBold
            rText.TextSize = 12
            rText.Text = "🔍 Searching for Murderer..."
        end

        radarGui.Visible = true
        local rText2 = radarGui:FindFirstChild("RadarText")
        local murderer = GetMurderer()
        if murderer and murderer.Character and murderer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local dist = math.floor((murderer.Character.HumanoidRootPart.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude)
            if dist < 25 then
                rText2.Text = string.format("🚨 DANGER! %s is %dm away!", murderer.Name, dist)
                rText2.TextColor3 = Color3.fromRGB(255, 60, 60)
            elseif dist < 50 then
                rText2.Text = string.format("⚠️ CAUTION: %s is %dm away", murderer.Name, dist)
                rText2.TextColor3 = Color3.fromRGB(255, 200, 50)
            else
                rText2.Text = string.format("🟢 SAFE: %s is %dm away", murderer.Name, dist)
                rText2.TextColor3 = Color3.fromRGB(100, 255, 150)
            end
        else
            rText2.Text = "🟢 Murderer: Hidden / Alive"
            rText2.TextColor3 = Color3.fromRGB(180, 190, 210)
        end
    else
        local oldR = Window.ScreenGui:FindFirstChild("Luno_MM2_Radar")
        if oldR then oldR.Visible = false end
    end

    -- Kill Aura Loop
    if Config.KillAura and LocalPlayer.Character then
        local knife = LocalPlayer.Character:FindFirstChild("Knife")
        if knife then
            local target = GetClosestTarget(Config.AuraRange)
            if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                local slashRemote = knife:FindFirstChild("Slash")
                if slashRemote then
                    slashRemote:FireServer(target.Character.HumanoidRootPart.Position)
                end
            end
        end
    end

    -- Tracers Loop
    if Config.Tracers then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local role = GetPlayerRole(player)
                if role == "Murderer" or role == "Sheriff" then
                    local root = player.Character.HumanoidRootPart
                    local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
                    if onScreen then
                        if not Tracers[player.Name] then
                            Tracers[player.Name] = Drawing.new("Line")
                            Tracers[player.Name].Thickness = 2
                            Tracers[player.Name].Transparency = 1
                        end
                        local line = Tracers[player.Name]
                        line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        line.To = Vector2.new(pos.X, pos.Y)
                        line.Color = GetRoleColor(role)
                        line.Visible = true
                    elseif Tracers[player.Name] then
                        Tracers[player.Name].Visible = false
                    end
                elseif Tracers[player.Name] then
                    Tracers[player.Name]:Remove()
                    Tracers[player.Name] = nil
                end
            end
        end
    else
        for k, v in pairs(Tracers) do
            v:Remove()
            Tracers[k] = nil
        end
    end
end)

