                local headPos = Camera:WorldToViewportPoint(root.Position + Vector3.new(0, 3, 0))
                local legPos = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3.5, 0))
                local height = math.abs(headPos.Y - legPos.Y)
                local width = height / 1.8
                bx.Size = Vector2.new(width, height)
                bx.Position = Vector2.new(pos.X - width / 2, headPos.Y)
                bx.Visible = true
            elseif Boxes[char] then
                Boxes[char].Visible = false
            end
        else 
            if Tracers[char] then Tracers[char].Visible=false end
            if Boxes[char] then Boxes[char].Visible=false end
        end
    else 
        if Tracers[char] then Tracers[char].Visible=false end 
        if Boxes[char] then Boxes[char].Visible=false end
    end
end

-- COMBAT ENGINE
local function IsVisible(targetPart)
    if not Config.WallCheck then return true end
    local cam = workspace.CurrentCamera
    if not cam or not targetPart then return false end
    
    local origin = cam.CFrame.Position
    local dir = targetPart.Position - origin

    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = {LocalPlayer.Character, targetPart.Parent}
    rp.IgnoreWater = true

    local result = workspace:Raycast(origin, dir, rp)
    return result == nil
end

local function GetTarget()
    local cam = workspace.CurrentCamera
    if not cam then return nil, nil end
    local mp = UserInputService:GetMouseLocation()
    local cp, ct = nil, nil
    local bestScore = math.huge

    for _, ch in ipairs(GetEnemies()) do
        if ch ~= LocalPlayer.Character then
                local hu = ch:FindFirstChildOfClass("Humanoid")
                local hrp = ch:FindFirstChild("HumanoidRootPart")
                if hu and hrp and hu.Health > 0 then
                    local worldDist = (hrp.Position - cam.CFrame.Position).Magnitude
                    if worldDist <= Config.MaxDist then
                        local head = ch:FindFirstChild("Head") or hrp
                        local tPart = head
                        if Config.TargetPart == "Torso" then tPart = hrp
                        elseif Config.TargetPart == "Random" then tPart = (math.random()>0.5) and head or hrp end
                        
                        -- CRITICAL FIX: Use WorldToScreenPoint to match GetMouseLocation!
                        local sp, onScreen = cam:WorldToScreenPoint(tPart.Position)
                        if onScreen then
                            local screenDist = (Vector2.new(sp.X, sp.Y) - mp).Magnitude
                            if screenDist <= Config.FOV then
                                if IsVisible(tPart) then
                                    local score = screenDist
                                    if Config.TargetPriority == "Closest Distance" then
                                        score = worldDist
                                    end
                                    
                                    if score < bestScore then
                                        bestScore = score
                                        cp = nil
                                        ct = tPart
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    return ct, cp
end

local function GetPredictedPosition(targetPart)
    if not Config.Prediction then return targetPart.Position end
    local velocity = targetPart.AssemblyLinearVelocity
    if velocity.Magnitude > 0 then
        return targetPart.Position + (velocity * Config.PredictionFactor)
    end
    return targetPart.Position
end



