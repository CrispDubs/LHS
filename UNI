W1:AddToggle("Boosted FPS", "", false, function(v)
    Config.FPSBoost = v
    if v then
        for _, o in ipairs(workspace:GetDescendants()) do
            if o:IsA("Decal") or o:IsA("Texture") then pcall(function() o.Transparency = 1 end)
            elseif o:IsA("BasePart") then pcall(function() o.Material = Enum.Material.SmoothPlastic end) end
        end
    end
end)
W1:AddToggle("Fullbright", "", false, function(v)
    Config.Fullbright = v
    if not v then
        Lighting.Ambient = OriginalLighting.Ambient
        Lighting.OutdoorAmbient = OriginalLighting.OutdoorAmbient
        Lighting.Brightness = OriginalLighting.Brightness
    end
end)
W1:AddToggle("Remove Fog", "", false, function(v)
    Config.NoFog = v
    if not v then Lighting.FogEnd = OriginalLighting.FogEnd end
end)
W1:AddToggle("No Shadows", "", false, function(v)
    Config.NoShadows = v
    if not v then Lighting.GlobalShadows = OriginalLighting.GlobalShadows end
end)

local W2 = WorldTab:AddSection("Physics & Camera")
W2:AddSlider("Gravity", 0, 196, 196, function(v)
    Config.Gravity = v
    workspace.Gravity = v
end)
W2:AddSlider("Camera FOV", 50, 120, 70, function(v)
    Config.CameraFOV = v
    if workspace.CurrentCamera then workspace.CurrentCamera.FieldOfView = v end
end)

-- SETTINGS TAB
local function UnloadScript()
    scriptRunning = false
    Config.ESP = false
    Config.Tracers = false
    Config.FlyEnabled = false
    Config.EnableSpeed = false
    Config.EnableJump = false
    Config.Noclip = false
    Config.InfiniteJump = false
    Config.Fullbright = false
    Config.NoFog = false
    Config.NoShadows = false

    StopFly()

    workspace.Gravity = 196
    if LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = 16; hum.JumpPower = 50 end
    end

    if ESPFolder then pcall(function() ESPFolder:Destroy() end) end

    if Lighting and OriginalLighting then
        Lighting.Ambient = OriginalLighting.Ambient
        Lighting.OutdoorAmbient = OriginalLighting.OutdoorAmbient
        Lighting.Brightness = OriginalLighting.Brightness
        Lighting.GlobalShadows = OriginalLighting.GlobalShadows
        Lighting.FogEnd = OriginalLighting.FogEnd
    end

    local g = game:GetService("CoreGui"):FindFirstChild("LunoUniversalFlat")
    if g then g:Destroy() end

    local pGuiG = LocalPlayer:FindFirstChild("PlayerGui") and LocalPlayer.PlayerGui:FindFirstChild("LunoUniversalFlat")
    if pGuiG then pGuiG:Destroy() end
end

local S1 = SettingsTab:AddSection("Script Controls")
S1:AddButton("Unload Script", UnloadScript)
S1:AddButton("Rejoin Server", function()
    pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer) end)
end)
S1:AddButton("Server Hop", function()
    pcall(function()
        local req = (syn and syn.request) or http_request or request
        if req then
            local res = req({Url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100", Method = "GET"})
            local body = game:GetService("HttpService"):JSONDecode(res.Body)
            if body and body.data then
                for _, sv in ipairs(body.data) do
                    if sv.playing < sv.maxPlayers and sv.id ~= game.JobId then
                        TeleportService:TeleportToPlaceInstance(game.PlaceId, sv.id, LocalPlayer)
                        return
                    end
                end
            end
        end
        TeleportService:Teleport(game.PlaceId, LocalPlayer)
    end)
end)

