local function safeGlideToPosition(targetPos, speed)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
    local hrp = char.HumanoidRootPart
    local hum = char:FindFirstChildOfClass("Humanoid")

    -- Enforce MM2 strict server speed threshold (<= 21.5 studs/sec) to avoid 'Invalid position' kick
    local safeSpeed = math.clamp(speed, 5, 21.5)
    local startPos = hrp.Position
    local totalDist = (targetPos - startPos).Magnitude

    if totalDist <= 1.2 then
        hrp.CFrame = CFrame.new(targetPos)
        fireNearbyCoinTouches(hrp, targetPos, 5)
        return true
    end

    local travelTime = totalDist / safeSpeed
    local startTime = tick()

    local originalGravity = workspace.Gravity
    workspace.Gravity = 0

    local noclipConn = RunService.Stepped:Connect(function()
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end)

    local success = true
    while (tick() - startTime) < travelTime do
        if not Config.AutoFarmEnabled or not isPlayerInActiveRound() then
            success = false
            break
        end

        local elapsed = tick() - startTime
        local alpha = math.clamp(elapsed / travelTime, 0, 1)
        local currentTargetPos = startPos:Lerp(targetPos, alpha)

        hrp.CFrame = CFrame.new(currentTargetPos)
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

        fireNearbyCoinTouches(hrp, currentTargetPos, 6)
        task.wait()
    end

    if success and Config.AutoFarmEnabled then
        hrp.CFrame = CFrame.new(targetPos)
        fireNearbyCoinTouches(hrp, targetPos, 6)
    end

    noclipConn:Disconnect()
    workspace.Gravity = originalGravity
    return success
end

