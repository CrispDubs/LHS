-- ESP ENGINE
-- ====================================================================
local ESPFolder = Instance.new("Folder")
ESPFolder.Name = "Luno_Universal_ESP"
pcall(function()
    if gethui then ESPFolder.Parent = gethui()
    else ESPFolder.Parent = game:GetService("CoreGui") end
end)
if not ESPFolder.Parent then ESPFolder.Parent = workspace end

local Tracers = {}

local function CleanupPlayerESP(player)
    local c = ESPFolder:FindFirstChild("ESP_" .. player.Name)
    if c then c:Destroy() end
    if Tracers[player] then
        pcall(function() Tracers[player]:Remove() end)
        Tracers[player] = nil
    end
end

local function UpdatePlayerESP(player)
    if player == LocalPlayer then return end
    local char = player.Character
    if not char then CleanupPlayerESP(player) return end

    local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
    local hum  = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then CleanupPlayerESP(player) return end

    if not Config.ESP and not Config.Tracers then
        CleanupPlayerESP(player)
        return
    end

    local isTeam = false
    if Config.TeamCheck and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
        isTeam = true
    end
    if isTeam then
        CleanupPlayerESP(player)
        return
    end

    if Config.ESP then
        local containerName = "ESP_" .. player.Name
        local container = ESPFolder:FindFirstChild(containerName)
        if not container then
            container = Instance.new("Folder")
            container.Name = containerName
            container.Parent = ESPFolder
        end

        local hl = container:FindFirstChildOfClass("Highlight")
        if Config.Chams then
            if not hl then
                hl = Instance.new("Highlight")
                hl.Parent = container
            end
            hl.Adornee = char
            hl.FillColor = Theme.Accent
            hl.FillTransparency = 0.5
            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
            hl.OutlineTransparency = 0
            hl.Enabled = true
        elseif hl then
            hl.Enabled = false
        end

        local bb = container:FindFirstChildOfClass("BillboardGui")
        if not bb then
            bb = Instance.new("BillboardGui")
            bb.Name = "BB"
            bb.AlwaysOnTop = true
            bb.Size = UDim2.new(4.5, 0, 6, 0)
            bb.StudsOffset = Vector3.new(0, 0, 0)
            bb.Parent = container

            local bf = Instance.new("Frame")
            bf.Name = "BoxFrame"
            bf.Size = UDim2.new(1, 0, 1, 0)
            bf.BackgroundTransparency = 1
            bf.BorderColor3 = Theme.Accent
            bf.BorderSizePixel = 2
            bf.Parent = bb

            local nl = Instance.new("TextLabel")
            nl.Name = "NameLabel"
            nl.Size = UDim2.new(1, 0, 0, 15)
            nl.Position = UDim2.new(0, 0, 0, -18)
            nl.BackgroundTransparency = 1
            nl.TextColor3 = Color3.fromRGB(255, 255, 255)
            nl.Font = Enum.Font.GothamBold
            nl.TextSize = 11
            nl.TextStrokeTransparency = 0
            nl.TextXAlignment = Enum.TextXAlignment.Center
            nl.Parent = bb

            local hbg = Instance.new("Frame")
            hbg.Name = "HBg"
            hbg.Size = UDim2.new(0, 4, 1, 0)
            hbg.Position = UDim2.new(0, -8, 0, 0)
            hbg.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
            hbg.BorderSizePixel = 1
            hbg.Parent = bb

            local hfl = Instance.new("Frame")
            hfl.Name = "HFl"
            hfl.Size = UDim2.new(1, 0, 1, 0)
            hfl.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
            hfl.BorderSizePixel = 0
            hfl.Parent = hbg
        end

        bb.Adornee = root
        local bf2 = bb:FindFirstChild("BoxFrame")
        if bf2 then bf2.Visible = Config.BoxESP end

        local nl2 = bb:FindFirstChild("NameLabel")
        if nl2 then
            nl2.Visible = Config.NameESP
            if Config.NameESP then
                local dist = math.floor((root.Position - Camera.CFrame.Position).Magnitude)
                nl2.Text = string.format("%s [%dm]", player.Name, dist)
            end
        end

        local hbg2 = bb:FindFirstChild("HBg")
        if hbg2 then
            hbg2.Visible = Config.HealthBar
            local hfl2 = hbg2:FindFirstChild("HFl")
            if hfl2 and hum then
                local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                hfl2.Size = UDim2.new(1, 0, pct, 0)
                hfl2.Position = UDim2.new(0, 0, 1 - pct, 0)
                if pct > 0.5 then
                    hfl2.BackgroundColor3 = Color3.fromRGB(math.floor(255 * (1 - pct) * 2), 255, 0)
                else
                    hfl2.BackgroundColor3 = Color3.fromRGB(255, math.floor(255 * pct * 2), 0)
                end
            end
        end
    else
        local c2 = ESPFolder:FindFirstChild("ESP_" .. player.Name)
        if c2 then c2:Destroy() end
    end

    if Config.Tracers and Drawing then
        local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
        if onScreen then
            if not Tracers[player] then
                local ln = Drawing.new("Line")
                ln.Thickness = 1.5
                ln.Color = Theme.Accent
                ln.Transparency = 1
                Tracers[player] = ln
            end
            local line = Tracers[player]
            line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
            line.To = Vector2.new(pos.X, pos.Y)
            line.Visible = true
        elseif Tracers[player] then
            Tracers[player].Visible = false
        end
    elseif Tracers[player] then
        Tracers[player].Visible = false
    end
end

