            hbg.Position=UDim2.new(0,-8,0,0); hbg.BackgroundColor3=Color3.fromRGB(20,20,20)
            hbg.BorderSizePixel=1; hbg.Parent=bb
            local hfl = Instance.new("Frame"); hfl.Name="HFl"; hfl.Size=UDim2.new(1,0,1,0)
            hfl.BackgroundColor3=Color3.fromRGB(0,255,100); hfl.BorderSizePixel=0; hfl.Parent=hbg
        end
        bb.Adornee = root
        local nl2 = bb:FindFirstChild("NameLabel")
        if nl2 then nl2.Visible = Config.NameESP
            if Config.NameESP then
                local d = math.floor((root.Position - Camera.CFrame.Position).Magnitude)
                nl2.Text = char.Name.." ["..d.."m]"
            end
        end
        local hbg2 = bb:FindFirstChild("HBg"); if hbg2 then hbg2.Visible = Config.HealthBar
            local hfl2 = hbg2:FindFirstChild("HFl")
            if hfl2 and hum then
                local pct = math.clamp(hum.Health/hum.MaxHealth,0,1)
                hfl2.Size = UDim2.new(1,0,pct,0); hfl2.Position = UDim2.new(0,0,1-pct,0)
                if pct > 0.5 then hfl2.BackgroundColor3 = Color3.fromRGB(math.floor(255*(1-pct)*2),255,0)
                else hfl2.BackgroundColor3 = Color3.fromRGB(255,math.floor(255*pct*2),0) end
            end
        end
    else
        local c2 = ESPFolder:FindFirstChild("ESP_"..char.Name); if c2 then c2:Destroy() end
    end

    if (Config.Tracers or Config.BoxESP) and Drawing then
        local pos, onSc = Camera:WorldToViewportPoint(root.Position)
        if onSc then
            if Config.Tracers then
                if not Tracers[char] then
                    local ln = Drawing.new("Line"); ln.Thickness=1.5; ln.Color=Theme.Accent
                    ln.Transparency=1; Tracers[char]=ln
                end
