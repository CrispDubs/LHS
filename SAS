RunService.RenderStepped:Connect(function(dt)
    Camera = workspace.CurrentCamera

    if Config.Aimbot then
        local ok=true
        if Config.HoldToAim then ok=UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) end
        if ok then
            local tp=GetTarget()
            if tp and Camera then
                local tPos = GetPredictedPosition(tp)
                
                if Config.HitChance < 100 and math.random(1, 100) > Config.HitChance then
                    tPos = tPos + Vector3.new(math.random(-3,3), math.random(-3,3), math.random(-3,3))
                end

                local sm=math.clamp(Config.AimbotSmoothness,1,20)
                if Config.AimbotMethod == "Camera" then
                    local cCF=Camera.CFrame; local tCF=CFrame.lookAt(cCF.Position,tPos)
                    Camera.CFrame=sm<=1 and tCF or cCF:Lerp(tCF,1/sm)
                elseif Config.AimbotMethod == "Mouse" then
                    local sp = Camera:WorldToScreenPoint(tPos)
                    local mp = UserInputService:GetMouseLocation()
                    local diffX = sp.X - mp.X
                    local diffY = (sp.Y + 36) - mp.Y -- Adjust for CoreGui Inset
                    if sm <= 1 then
                        if mousemoverel then mousemoverel(diffX, diffY) end
                    else
                        if mousemoverel then mousemoverel(diffX / sm, diffY / sm) end
                    end
                end
            end
        end
    end

    if FOVCircle then
        FOVCircle.Position=UserInputService:GetMouseLocation()
        if Config.DynamicFOV and Camera then
            local fovFactor = 70 / Camera.FieldOfView
            FOVCircle.Radius = Config.FOV * fovFactor
        else
            FOVCircle.Radius = Config.FOV
        end
        FOVCircle.Visible=Config.ShowFOV and Config.Aimbot
    end


    if LocalPlayer.Character then
        local h=LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if h then
            if Config.EnableSpeed then h.WalkSpeed=Config.WalkSpeed end
            if Config.EnableJump  then h.UseJumpPower=true; h.JumpPower=Config.JumpPower end
        end
        if Config.Spinbot and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = LocalPlayer.Character.HumanoidRootPart
            hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(Config.SpinSpeed), 0)
        end
    end

    -- Hitbox and Weapon logic successfully migrated to async loop

    workspace.Gravity = Config.Gravity
    if Config.Fullbright then
        Lighting.Ambient=Color3.fromRGB(255,255,255); Lighting.OutdoorAmbient=Color3.fromRGB(255,255,255); Lighting.Brightness=2
    elseif Config.NightMode then
        Lighting.ClockTime=0; Lighting.OutdoorAmbient=Color3.fromRGB(20,20,40); Lighting.Ambient=Color3.fromRGB(15,15,30)
    end
    if Config.NoShadows then Lighting.GlobalShadows=false end
    if Config.NoFog     then Lighting.FogEnd=9e9 end
    if Camera           then Camera.FieldOfView=Config.CameraFOV end

    local currentEnemies = GetEnemies()
    local enemySet = {}
    for _, char in ipairs(currentEnemies) do
        enemySet[char] = true
        UpdatePlayerESP(char)
    end
    for char, _ in pairs(Tracers) do
        if not enemySet[char] then CleanupPlayerESP(char) end
    end
    for char, _ in pairs(Boxes) do
        if not enemySet[char] then CleanupPlayerESP(char) end
    end
end)
