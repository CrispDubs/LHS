local function GetEnemies()
    local enemies = {}
    local customFolder = workspace:FindFirstChild("Highlight")
    if customFolder then
        local enemyFolder = customFolder:FindFirstChild("Enemy")
        if enemyFolder then
            local holder = enemyFolder:FindFirstChild("HighlightHolder")
            if holder then
                for _, model in ipairs(holder:GetChildren()) do
                    if model:IsA("Model") then
                        table.insert(enemies, model)
                    end
                end
                return enemies
            end
        end
    end
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LocalPlayer and pl.Character then
            table.insert(enemies, pl.Character)
        end
    end
    return enemies
end

local function CleanupPlayerESP(char)
    if not char then return end
    local c = ESPFolder:FindFirstChild("ESP_" .. char.Name)
    if c then c:Destroy() end
    if Tracers[char] then
        pcall(function() Tracers[char]:Remove() end)
        Tracers[char] = nil
    end
    if Boxes[char] then
        pcall(function() Boxes[char]:Remove() end)
        Boxes[char] = nil
    end
end

local function UpdatePlayerESP(char)
    if not char or char == LocalPlayer.Character then return end
    local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
    local hum  = char:FindFirstChildOfClass("Humanoid")
    if not Config.ESP and not Config.Tracers then CleanupPlayerESP(char) return end
    if not root or not hum or hum.Health <= 0 then CleanupPlayerESP(char) return end
    


    if Config.ESP then
        local cn = "ESP_" .. char.Name
