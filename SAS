        if not container then container = Instance.new("Folder"); container.Name = cn; container.Parent = ESPFolder end

        local hl = container:FindFirstChildOfClass("Highlight")
        if Config.Chams then
            if not hl then hl = Instance.new("Highlight"); hl.Parent = container end
            hl.Adornee = char; hl.FillColor = Theme.Accent; hl.FillTransparency = 0.5
            hl.OutlineColor = Color3.fromRGB(255,255,255); hl.OutlineTransparency = 0; hl.Enabled = true
