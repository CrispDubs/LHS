task.spawn(function()
    while scriptRunning do
        task.wait(0.2)
        if not scriptRunning then break end
        if not Config.AutoFarmEnabled then
            StatusPill.Text = "Status: 🔴 Farm Paused"
            StatusPill.TextColor3 = Color3.fromRGB(255, 100, 100)
            isBusy = false
        elseif isPlayerInActiveRound() then
            local liveCoins = getActualCoinsFromGame()
            if liveCoins ~= nil then
                if liveCoins > currentRoundCoins then
                    local diff = (liveCoins - currentRoundCoins)
                    sessionCoinsCollected = sessionCoinsCollected + diff
                    currentRoundCoins = liveCoins
                elseif liveCoins < currentRoundCoins and liveCoins == 0 then
                    currentRoundCoins = 0
                end
                lastRecordedBag = liveCoins
            end

            SessionStatLabel.Text = string.format("SESSION COINS\n%d", sessionCoinsCollected)
            BagStatLabel.Text = string.format("BAG CAPACITY\n%d / %d", currentRoundCoins, Config.MAX_BAG_CAP)

            if currentRoundCoins >= Config.MAX_BAG_CAP then
                StatusPill.Text = "Status: 🎒 Bag FULL (40/40) — Waiting for Round End..."
                StatusPill.TextColor3 = Color3.fromRGB(255, 215, 0)
                isBusy = false
            else
                local targetCoin, dist = getClosestSafeCoin()
                if targetCoin then
                    StatusPill.Text = string.format("Status: ⚡ Collecting Coin (%d studs)...", math.floor(dist))
                    StatusPill.TextColor3 = Color3.fromRGB(0, 240, 150)

                    isBusy = true
                    local coinPos = targetCoin:IsA("BasePart") and targetCoin.Position or targetCoin:GetPivot().Position
                    local ok = safeGlideToPosition(coinPos, Config.FarmSpeed)

                    if not ok then
                        coinFailTracker[targetCoin] = (coinFailTracker[targetCoin] or 0) + 1
                        if coinFailTracker[targetCoin] >= 2 then
                            coinBlacklist[targetCoin] = tick() + 6
                        end
                    else
                        coinFailTracker[targetCoin] = nil
                    end

                    task.wait(0.01)
                    local afterCoins = getActualCoinsFromGame()
                    if afterCoins ~= nil then
                        if afterCoins > currentRoundCoins then
                            sessionCoinsCollected = sessionCoinsCollected + (afterCoins - currentRoundCoins)
                            currentRoundCoins = afterCoins
                        end
                    else
                        currentRoundCoins = math.min(currentRoundCoins + 1, Config.MAX_BAG_CAP)
                        sessionCoinsCollected = sessionCoinsCollected + 1
                    end

                    SessionStatLabel.Text = string.format("SESSION COINS\n%d", sessionCoinsCollected)
                    BagStatLabel.Text = string.format("BAG CAPACITY\n%d / %d", currentRoundCoins, Config.MAX_BAG_CAP)
                    isBusy = false
                else
                    StatusPill.Text = "Status: 🔍 Round Active — Searching for Coins..."
                    StatusPill.TextColor3 = Color3.fromRGB(180, 190, 210)
                    isBusy = false
                    task.wait(0.03)
                end
            end
        else
            currentRoundCoins = 0
            BagStatLabel.Text = string.format("BAG CAPACITY\n0 / %d", Config.MAX_BAG_CAP)
            StatusPill.Text = "Status: ⏳ Waiting in Lobby for Round Start..."
            StatusPill.TextColor3 = Color3.fromRGB(160, 170, 195)
            isBusy = false
            task.wait(0.5)
        end
    end
end)

