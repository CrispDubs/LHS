local function isValidCoin(part)
    if not part or not part:IsA("BasePart") then return false end
    if part.Transparency >= 0.95 then return false end
    if coinBlacklist[part] and tick() < coinBlacklist[part] then return false end

    if part:FindFirstAncestor("Lobby") or part:FindFirstAncestor("Shop") or part:FindFirstAncestor("PlayerGui") or part:FindFirstAncestor("CoreGui") then
        return false
    end

    local name = part.Name:lower()
    local parentName = part.Parent and part.Parent.Name:lower() or ""
    local grandParentName = (part.Parent and part.Parent.Parent) and part.Parent.Parent.Name:lower() or ""

    if name == "coinvisual" or name == "maincoin" or name == "coin" or name:find("coin") or name:find("token") or name:find("beachball") then
        return true
    end

    if parentName:find("coincontainer") or parentName:find("coinserver") or parentName:find("coin") or grandParentName:find("coincontainer") then
        return true
    end

    return false
end

local cachedCoins = {}
local lastCoinScan = 0

local function getAllCoinsOnMap()
    if tick() - lastCoinScan < 1 then
        local validCoins = {}
        for _, coin in ipairs(cachedCoins) do
            if coin and coin.Parent and coin.Transparency < 0.95 and not (coinBlacklist[coin] and tick() < coinBlacklist[coin]) then
                table.insert(validCoins, coin)
            end
        end
        cachedCoins = validCoins
        return cachedCoins
    end
    
    lastCoinScan = tick()
    local coinList = {}
    local seen = {}

    -- Direct search inside any CoinContainer in workspace (e.g. workspace.MilBase.CoinContainer)
    for _, desc in ipairs(workspace:GetDescendants()) do
        if desc.Name == "CoinContainer" or desc.Name:lower():find("coincontainer") then
            for _, coinDesc in ipairs(desc:GetDescendants()) do
                if isValidCoin(coinDesc) and not seen[coinDesc] then
                    seen[coinDesc] = true
                    table.insert(coinList, coinDesc)
                end
            end
        end
    end

    -- Universal fallback scan if CoinContainer is not uniquely named
    if #coinList == 0 then
        for _, desc in ipairs(workspace:GetDescendants()) do
            if isValidCoin(desc) and not seen[desc] then
                seen[desc] = true
                table.insert(coinList, desc)
            end
        end
    end
    
    cachedCoins = coinList
    return coinList
end

local function fireNearbyCoinTouches(hrp, position, radius)
    pcall(function()
        if not firetouchinterest then return end
        local char = hrp.Parent
        if not char then return end

        local coins = getAllCoinsOnMap()
        for _, part in ipairs(coins) do
            if (part.Position - position).Magnitude <= radius then
                firetouchinterest(hrp, part, 0)
                firetouchinterest(hrp, part, 1)

                if part.Parent and part.Parent:IsA("BasePart") then
                    firetouchinterest(hrp, part.Parent, 0)
                    firetouchinterest(hrp, part.Parent, 1)
                end

                local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("Head")
                if torso then
                    firetouchinterest(torso, part, 0)
                    firetouchinterest(torso, part, 1)
                end
            end
        end
    end)
end

local function isPlayerInActiveRound()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end

    -- Priority: Always active whenever coins exist on the map (even if spectating / waiting for turns)
    local coins = getAllCoinsOnMap()
    if #coins > 0 then return true end

    if isSpectating() then return false end

    local murderer = getPlayerByRole("Murderer")
    local isSelfMurderer = (getPlayerRole(LocalPlayer) == "Murderer")
    if not murderer and not isSelfMurderer then return false end

    return true
end

local function getClosestSafeCoin()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil, math.huge end
    local hrp = char.HumanoidRootPart

    local murderer = getPlayerByRole("Murderer")
    local murHrp = (murderer and murderer.Character) and murderer.Character:FindFirstChild("HumanoidRootPart")

    local closestCoin = nil
    local shortestDist = math.huge

    local coins = getAllCoinsOnMap()
    for _, obj in ipairs(coins) do
        if obj and obj.Parent then
            local coinPos = obj:IsA("BasePart") and obj.Position or obj:GetPivot().Position
            local safe = true
            if murHrp and (coinPos - murHrp.Position).Magnitude < 22 then
                safe = false
            end

            if safe then
                local dist = (hrp.Position - coinPos).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closestCoin = obj
                end
            end
        end
    end

    return closestCoin, shortestDist
end

