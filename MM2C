local function UnloadScript()
    scriptRunning = false
    Config.KillAura = false
    Config.KillAllAsMurderer = false
    Config.AutoCollectGun = false
    Config.MurdererRadar = false
    Config.RoleESP = false
    Config.BoxESP = false
    Config.NameESP = false
    Config.Tracers = false
    Config.GunESP = false
    Config.CoinESP = false
    Config.EnableSpeed = false
    Config.EnableJump = false
    Config.InfiniteJump = false
    Config.NoClip = false
    Config.XRay = false

    if renderConn then pcall(function() renderConn:Disconnect() end) end
    if steppedConn then pcall(function() steppedConn:Disconnect() end) end
    if jumpConn then pcall(function() jumpConn:Disconnect() end) end
    if gunConn then pcall(function() gunConn:Disconnect() end) end

    if LocalPlayer.Character then
        local h = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if h then h.WalkSpeed = 16; h.JumpPower = 50 end
    end

    for obj, trans in pairs(OriginalTransparencies) do
        if obj and obj.Parent then obj.Transparency = trans end
    end

    for _, pl in ipairs(Players:GetPlayers()) do RemovePlayerESP(pl) end
    for k, v in pairs(Tracers) do pcall(function() v:Remove() end); Tracers[k] = nil end

    if Window and Window.ScreenGui then Window.ScreenGui:Destroy() end
    local g = game:GetService("CoreGui"):FindFirstChild("LunoMM2CombatFlat")
    if g then g:Destroy() end

    print("[Luno MM2 Combat] Unloaded Successfully.")
end

