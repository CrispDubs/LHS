local function isKnifeTool(tool)
    if not tool or not tool:IsA("Tool") then return false end
    local name = tool.Name:lower()
    if name:find("knife") or name:find("slash") or name:find("blade") or name:find("sword") or name:find("dagger") or name:find("harvester") or name:find("bat") then
        return true
    end
    if tool:FindFirstChild("KnifeServer") or tool:FindFirstChild("Stab") or tool:FindFirstChild("Slash") or tool:FindFirstChild("Throw") or tool:FindFirstChild("TouchInterest", true) then
        return true
    end
    return false
end

local function isGunTool(tool)
    if not tool or not tool:IsA("Tool") then return false end
    local name = tool.Name:lower()
    if name:find("gun") or name:find("revolver") or name:find("sheriff") or name:find("pistol") or name:find("blaster") then
        return true
    end
    if tool:FindFirstChild("GunServer") or tool:FindFirstChild("Shoot") or tool:FindFirstChild("ShootGun") or tool:FindFirstChild("Bullet") then
        return true
    end
    return false
end

local function getPlayerRole(player)
    if not player or not player.Character then return "Innocent" end
    local character = player.Character
    local backpack = player:FindFirstChild("Backpack")

    local function searchContainer(container, checkFn)
        if not container then return false end
        for _, child in ipairs(container:GetChildren()) do
            if checkFn(child) then return true end
        end
        return false
    end

    if searchContainer(character, isKnifeTool) or searchContainer(backpack, isKnifeTool) then
        return "Murderer"
    elseif searchContainer(character, isGunTool) or searchContainer(backpack, isGunTool) then
        return "Sheriff"
    end
    return "Innocent"
end

local function getPlayerByRole(roleName)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and getPlayerRole(p) == roleName then
            return p
        end
    end
    return nil
end

local function isSpectating()
    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    if pGui then
        local mainGui = pGui:FindFirstChild("MainGUI") or pGui:FindFirstChild("ScreenGui")
        if mainGui and mainGui:FindFirstChild("Game") and mainGui.Game:FindFirstChild("Spectate") then
            return mainGui.Game.Spectate.Visible
        end
    end
    return false
end

local function getActualCoinsFromGame()
    local count = nil
    pcall(function()
        local pGui = LocalPlayer:FindFirstChild("PlayerGui")
        if not pGui then return end
        local mainGui = pGui:FindFirstChild("MainGUI") or pGui:FindFirstChild("ScreenGui") or pGui:FindFirstChildWhichIsA("ScreenGui")
        if not mainGui then return end

        for _, desc in ipairs(mainGui:GetDescendants()) do
            if desc:IsA("TextLabel") and desc.Visible then
                local txt = desc.Text
                if txt and txt:find("/") then
                    local current, maxC = txt:match("(%d+)%s*/%s*(%d+)")
                    if current and maxC then
                        local val = tonumber(current)
                        local mVal = tonumber(maxC)
                        if val and mVal and val >= 0 and val <= mVal and mVal >= 10 and mVal <= 100 then
                            count = val
                            break
                        end
                    end
                end
            end
        end

        if count == nil then
            for _, desc in ipairs(mainGui:GetDescendants()) do
                if desc:IsA("TextLabel") then
                    local p = desc.Parent
                    local pName = p and p.Name:lower() or ""
                    if pName:find("coin") or pName:find("bag") or desc.Name:lower():find("coin") then
                        local txt = desc.Text
                        if txt then
                            local val = tonumber(txt:match("(%d+)"))
                            if val and val >= 0 and val <= Config.MAX_BAG_CAP then
                                count = val
                                break
                            end
                        end
                    end
                end
            end
        end
    end)
    return count
end

